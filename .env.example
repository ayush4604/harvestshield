# Set in your environment; the application does not load .env automatically.
DATA_GOV_API_KEY=
# Production backend automatically collects these reported daily prices.
# Public dashboard remains read-only; the trusted collector writes internally.
HARVESTSHIELD_AUTO_REFRESH=true
HARVESTSHIELD_FEED_STATE=Maharashtra
HARVESTSHIELD_FEED_COMMODITY=Tomato
HARVESTSHIELD_FEED_MARKET=
HARVESTSHIELD_REFRESH_SECONDS=21600
HARVESTSHIELD_FEED_MAX_PAGES=3
HARVESTSHIELD_API_URL=http://127.0.0.1:8000
# Optional custom absolute path, defaults to this project's data directory.
HARVESTSHIELD_DATA_DIR=
# Local defaults keep Windows use unchanged. Production defaults to read-only.
HARVESTSHIELD_ENV=local
HARVESTSHIELD_READ_ONLY=false
HARVESTSHIELD_ADMIN_TOKEN=
HARVESTSHIELD_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Compose loads .env itself; Windows launcher does not. Never expose admin tokens
# to the public Streamlit process or place them in browser-visible settings.
